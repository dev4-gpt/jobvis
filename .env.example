# Job Scout — environment configuration.
# Copy to `.env` and fill in. The app runs with NO keys at all (Remotive +
# cached dataset), but you get the full lesson (real cost, live jobs, tracing)
# with the three services below.
#
# NOTE: put values directly after `=` with nothing else on the line. Do not add
# inline `# comments` after a value — for empty keys some dotenv parsers read the
# comment as the value.

# --- LLM (required for a real run) ------------------------------------------
# Default model. gpt-4o-mini / gpt-4.1-mini report real cost in Opik.
# Free alternatives (cost shows as $0.00 in Opik):
#   groq:openai/gpt-oss-20b       (needs GROQ_API_KEY, `uv sync --extra groq`)
#   nvidia:openai/gpt-oss-20b     (needs NVIDIA_API_KEY; hosted NIM endpoint)
#   ollama:qwen3.5:4b              (local, needs Ollama running, `uv sync --extra ollama`)
SCOUT_MODEL=openai:gpt-4o-mini
# Optional (Phase 2). Defaults to the same as SCOUT_MODEL.
# Part 2 blog numbers were produced with openai:gpt-4.1-mini
SCOUT_TAILOR_MODEL=
# Optional bounded failover chain for ranking/profile model outages or rate
# limits. Keep empty unless you intentionally accept additional provider calls;
# candidates are tried left-to-right, and the run budget includes every try.
# Example: SCOUT_FALLBACK_MODELS=nvidia:openai/gpt-oss-20b,openai:some/model
SCOUT_FALLBACK_MODELS=
# Required for the default model:
OPENAI_API_KEY=
# For an OpenRouter key, set this as well and use OpenAI-compatible model IDs,
# for example: SCOUT_MODEL=openai:openai/gpt-4o-mini
OPENAI_BASE_URL=
# Optional; only if SCOUT_MODEL uses groq:
GROQ_API_KEY=
# Optional NVIDIA hosted NIM credentials. Use `nvidia:publisher/model` in a
# model setting, for example `nvidia:openai/gpt-oss-20b`.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional; defaults to the local Ollama server:
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Opik observability (recommended — this is the point of the project) -----
# From https://www.comet.com/ (free).
OPIK_API_KEY=
# Your Comet workspace name. Leave EMPTY to use your API key's default workspace.
OPIK_WORKSPACE=
# Optional (default: job-scout):
OPIK_PROJECT_NAME=job-scout
# Set to false to disable all tracing. With tracing enabled, the uploaded CV may
# be attached to Opik; read docs/privacy.md before using personal data.
OPIK_ENABLED=true

# --- JSearch (optional — primary live source, best city-level location) ------
# Official Google-for-Jobs aggregator (OpenWeb Ninja). Free tier ~200 req/month,
# so it's used for the live app; the batch/offline path stays on Adzuna + cache.
JSEARCH_API_KEY=

# --- Adzuna jobs API (optional — free international source) -------------------
# Free registration: https://developer.adzuna.com/ . Without any key above, the
# app uses Remotive (keyless) and the committed cache in data/cached_jobs.json.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Tavily (optional — Phase 2 company research) -----------------------------
# When set, the tailor node makes ONE Tavily search per run to ground the cover
# letter's company facts. Keyless path skips research entirely; nothing breaks.
# Free tier: https://tavily.com/
TAVILY_API_KEY=

# --- Jobvis voice (optional — the voice console) ------------------------------
# ElevenLabs Agents powers Jobvis. The conversation runs in your BROWSER over
# WebRTC; this key stays server-side and only mints short-lived session tokens.
# Sign up (free tier: 15 conversation minutes/month), then:
#   make jobvis-agent        # creates the agent, prints ELEVENLABS_AGENT_ID
#   make web-build && make app        # wizard on :7860, console on :8000
# The key needs the Agents Platform (Conversational AI) read + write scopes.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Use 8001 if another local app already owns port 8000.
JOBVIS_CONSOLE_PORT=8000
# Optional: use another wizard port if :7860 is already occupied.
JOBVIS_WIZARD_PORT=7860
# Optional: a specific voice id (default: the stock "Daniel", fallback "George"):
ELEVENLABS_VOICE_ID=
# Hand control (pinch to spin the orb) is a FRONTEND flag, not one of these —
# see web/.env.local and `make web-assets` in docs/jobvis.md.

# --- Guardrails --------------------------------------------------------------
# Optional circuit breaker (default: 25):
MAX_LLM_CALLS_PER_RUN=25
# Jobs fetched and ranked per search (default: 10 → 2 ranking batches, roughly
# half a minute end to end). The Phase 2 baselines/evals ran with 25.
SCOUT_MAX_JOBS=10
# Broaden-the-search loops when fits are thin (default: 2, the agent lesson).
# Set 0 for demo/latency mode: one pass, ~10-15s per search.
SCOUT_MAX_REFORMULATIONS=2
# Choosing search_jobs arguments is a trivial tool call — a small model does it
# in ~1s. Empty = use SCOUT_MODEL. See docs/optimizing_latency.md.
SCOUT_FETCH_MODEL=
# Jobs per ranking batch (default 4). Batches run in parallel, so smaller
# batches lower the slowest-batch latency at the cost of a few more LLM calls.
SCOUT_RANK_BATCH=4
# Maximum seconds to wait for each concurrent ranking batch.
SCOUT_RANK_TIMEOUT=45
# Maximum time per profile-extraction provider call before using the local,
# source-grounded profile fallback.
SCOUT_PROFILE_TIMEOUT=20
# Maximum time per tailoring-provider call before using the grounded fallback.
SCOUT_TAILOR_TIMEOUT=45
# Maximum bounded, deterministic-backtest-guided repair calls for a tailored
# pack. Set 0 to disable repair calls; the backtest still runs (default: 2).
SCOUT_TAILOR_MAX_REPAIRS=2
# Maximum number of deterministic role-title searches in one candidate-aware run.
# The resulting jobs are still capped globally by SCOUT_MAX_JOBS.
SCOUT_MAX_ROLE_QUERIES=6
# Bounded concurrency for those independent role-title searches.
SCOUT_QUERY_CONCURRENCY=3
# Query the live job sources concurrently (default: true). The cascade's
# consumption order and thresholds are unchanged; only the waiting overlaps.
# Set false to restore the Phase 1/2 sequential fallback behavior:
SCOUT_CONCURRENT_SOURCES=true
# Seconds the concurrent cascade waits for the primary source before falling
# through to sources that have already finished. It does NOT drop the primary:
# if the others come up short it is waited on in full afterwards. Measured, not
# guessed: the wall clock equals this value on every search (adzuna is done by
# ~1s), and jsearch has never returned under 8s, so raising it buys nothing:
SCOUT_SOURCE_SOFT_DEADLINE=1.0

# --- Fabrication validator thresholds (the tuning exercise) -------------------
# Deterministic difflib ratios; a claim below its threshold is flagged. Every
# FabricationReport records the values it ran with — visible in the Opik trace —
# so tune, re-run, and compare. Phase 2 baselines were measured at 0.75/0.9/0.55.
SCOUT_FAB_BULLET_RATIO=0.65
SCOUT_FAB_SKILL_RATIO=0.85
SCOUT_FAB_LETTER_RATIO=0.55
